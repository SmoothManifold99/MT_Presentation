@article{sorokinIntroductoryNotesNonlinear2022,
  title = {Introductory {{Notes}} on {{Non-linear Electrodynamics}} and Its {{Applications}}},
  author = {Sorokin, D. P.},
  date = {2022-08},
  journaltitle = {Fortschritte der Physik},
  shortjournal = {Fortschritte der Physik},
